{
  "info": {
    "name": "Wallet Transfer Service",
    "_postman_id": "3a5f9d54-b6db-4b37-8a01-92aeeb12770f",
    "description": "Preconfigured requests for wallet transfer APIs (happy path, idempotency, and validation/error scenarios).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Transfers",
      "item": [
        {
          "name": "Create Transfer - Success",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idempotencyKey\": \"txn-001\",\n  \"fromWalletId\": \"wallet_1\",\n  \"toWalletId\": \"wallet_2\",\n  \"amount\": 100\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transfers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transfers"
              ]
            },
            "description": "Expected: 200 OK, status PROCESSED"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('response has transferId and PROCESSED', function () {",
                  "  pm.expect(json.transferId).to.be.a('string').and.not.empty;",
                  "  pm.expect(json.status).to.eql('PROCESSED');",
                  "});",
                  "",
                  "pm.collectionVariables.set('lastTransferId', json.transferId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Transfer - Idempotency Replay (same key)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idempotencyKey\": \"txn-001\",\n  \"fromWalletId\": \"wallet_1\",\n  \"toWalletId\": \"wallet_2\",\n  \"amount\": 100\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transfers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transfers"
              ]
            },
            "description": "Expected: 200 OK and same transfer result as first txn-001 request"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('response still PROCESSED', function () {",
                  "  pm.expect(json.status).to.eql('PROCESSED');",
                  "});"
                ]
              }
            }
          ]
        },
